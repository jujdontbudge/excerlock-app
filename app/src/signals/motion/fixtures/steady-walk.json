{
  "name": "steady-walk",
  "version": 1,
  "description": "High-confidence walking with a stable 1.7 steps-per-second cadence.",
  "timeline": [
    {
      "atMs": 1000,
      "event": "motion.activityChange",
      "payload": { "activity": "walking", "confidence": "high" }
    },
    {
      "atMs": 2000,
      "event": "motion.pedometerUpdate",
      "payload": { "steps": 3, "cadence": 1.7 }
    },
    {
      "atMs": 15000,
      "event": "motion.pedometerUpdate",
      "payload": { "steps": 25, "cadence": 1.7 }
    },
    {
      "atMs": 30000,
      "event": "motion.pedometerUpdate",
      "payload": { "steps": 51, "cadence": 1.7 }
    }
  ]
}
