{
  "name": "tick-ladder-basic",
  "version": 1,
  "description": "An ordered one-minute threshold ladder with two historical ticks and two future ticks.",
  "timeline": [
    {
      "atMs": -120000,
      "event": "screentime.tick",
      "payload": { "thresholdIndex": 1 }
    },
    {
      "atMs": -60000,
      "event": "screentime.tick",
      "payload": { "thresholdIndex": 2 }
    },
    {
      "atMs": 60000,
      "event": "screentime.tick",
      "payload": { "thresholdIndex": 3 }
    },
    {
      "atMs": 120000,
      "event": "screentime.tick",
      "payload": { "thresholdIndex": 4 }
    }
  ]
}
