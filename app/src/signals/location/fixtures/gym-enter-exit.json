{
  "name": "gym-enter-exit",
  "version": 1,
  "description": "A clean gym-region entry, accurate location update, and later exit.",
  "timeline": [
    {
      "atMs": 1000,
      "event": "location.enterRegion",
      "payload": { "regionId": "gym-primary" }
    },
    {
      "atMs": 2000,
      "event": "location.update",
      "payload": { "lat": 40.741, "lon": -73.989, "accuracy": 8 }
    },
    {
      "atMs": 60000,
      "event": "location.exitRegion",
      "payload": { "regionId": "gym-primary" }
    }
  ]
}
