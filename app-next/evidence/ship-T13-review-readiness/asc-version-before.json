8eddef2fe6c8/relationships/alternativeDistributionPackage","related":"https://api.appstoreconnect.apple.com/v1/appStoreVersions/c216ad37-5c79-4be8-9cdb-8eddef2fe6c8/alternativeDistributionPackage"}}},"links":{"self":"https://api.appstoreconnect.apple.com/v1/appStoreVersions/c216ad37-5c79-4be8-9cdb-8eddef2fe6c8"}}],"links":{"self":"https://api.appstoreconnect.apple.com/v1/apps/6787265352/appStoreVersions?filter%5Bplatform%5D=IOS\u0026include=appStoreVersionLocalizations"},"included":[{"attributes":{"description":"Your distracting apps share one daily time budget. When it runs out, they lock.\nA real workout buys it back.\n\nExcerLock is a screen-time app for adults who want to scroll less and train more.\nYou choose which of your own apps to limit and how many minutes they get per day.\nUsing them drains the balance in real time. At zero, the apps are shielded by\nApple's built-in Screen Time technology — until you earn more time by moving.\n\nHOW YOU EARN\n• Visit the gym — confirmed by actually being there\n• Or hit any fitness goal you set: a run, a ride, a swim, steps, active calories,\n  active minutes — read from Apple Health\n• Only real, device-recorded activity counts. Manually-typed entries don't.\n\nYOU MAKE THE RULES\n• Set the daily budget — or set it to zero for \"locked until I move\"\n• Choose your reward: a fixed chunk of time, the rest of the day, or a set period\n• Rest days, custom days, sick-day tokens, and vacation mode — the system bends\n  to your life without breaking your streak\n• Every rule is yours to configure. No willpower talk, no shaming.\n\nPRIVATE BY DESIGN\n• No account. No server. Nothing to sign up for.\n• The apps you limit are opaque tokens — ExcerLock cannot see which apps they are\n• Health and location data are processed on your device and never leave it\n\nExcerLock is a self-control tool for managing your own device. It is not a\nparental-control app.","keywords":"screen time,app blocker,focus,gym,workout,running,walk,earn,limit,habit,doomscroll,fitness lock","locale":"en-US","marketingUrl":"https://johansardar.github.io/excerlock/","promotionalText":"Earn your screen time. Your apps share a daily budget — when it's gone they lock, and a real workout buys it back. Any exercise counts, read from Apple Health.","supportUrl":"https://johansardar.github.io/excerlock/#support","whatsNew":null},"id":"da0f8b3a-3aaf-425c-be27-45e778151297","links":{"self":"https://api.appstoreconnect.apple.com/v1/appStoreVersionLocalizations/da0f8b3a-3aaf-425c-be27-45e778151297"},"relationships":{"appScreenshotSets":{"links":{"self":"https://api.appstoreconnect.apple.com/v1/appStoreVersionLocalizations/da0f8b3a-3aaf-425c-be27-45e778151297/relationships/appScreenshotSets","related":"https://api.appstoreconnect.apple.com/v1/appStoreVersionLocalizations/da0f8b3a-3aaf-425c-be27-45e778151297/appScreenshotSets"}},"appPreviewSets":{"links":{"self":"https://api.appstoreconnect.apple.com/v1/appStoreVersionLocalizations/da0f8b3a-3aaf-425c-be27-45e778151297/relationships/appPreviewSets","related":"https://api.appstoreconnect.apple.com/v1/appStoreVersionLocalizations/da0f8b3a-3aaf-425c-be27-45e778151297/appPreviewSets"}},"searchKeywords":{"links":{"self":"https://api.appstoreconnect.apple.com/v1/appStoreVersionLocalizations/da0f8b3a-3aaf-425c-be27-45e778151297/relationships/searchKeywords","related":"https://api.appstoreconnect.apple.com/v1/appStoreVersionLocalizations/da0f8b3a-3aaf-425c-be27-45e778151297/searchKeywords"}}},"type":"appStoreVersionLocalizations"}],"meta":{"paging":{"total":1,"limit":50}}}
