for managing your own device; it is not a parental-control or medical app.","keywords":"screen time,app blocker,focus,gym,walking,exercise,limit,habit,doomscroll,fitness,unlock","locale":"en-US","marketingUrl":"https://excerlock.com/","promotionalText":"Choose distracting apps, complete a walking or gym condition, and unlock according to rules you control.","supportUrl":"https://excerlock.com/support","whatsNew":null},"id":"da0f8b3a-3aaf-425c-be27-45e778151297","links":{"self":"https://api.appstoreconnect.apple.com/v1/appStoreVersionLocalizations/da0f8b3a-3aaf-425c-be27-45e778151297"},"relationships":{"appScreenshotSets":{"links":{"self":"https://api.appstoreconnect.apple.com/v1/appStoreVersionLocalizations/da0f8b3a-3aaf-425c-be27-45e778151297/relationships/appScreenshotSets","related":"https://api.appstoreconnect.apple.com/v1/appStoreVersionLocalizations/da0f8b3a-3aaf-425c-be27-45e778151297/appScreenshotSets"}},"appPreviewSets":{"links":{"self":"https://api.appstoreconnect.apple.com/v1/appStoreVersionLocalizations/da0f8b3a-3aaf-425c-be27-45e778151297/relationships/appPreviewSets","related":"https://api.appstoreconnect.apple.com/v1/appStoreVersionLocalizations/da0f8b3a-3aaf-425c-be27-45e778151297/appPreviewSets"}},"searchKeywords":{"links":{"self":"https://api.appstoreconnect.apple.com/v1/appStoreVersionLocalizations/da0f8b3a-3aaf-425c-be27-45e778151297/relationships/searchKeywords","related":"https://api.appstoreconnect.apple.com/v1/appStoreVersionLocalizations/da0f8b3a-3aaf-425c-be27-45e778151297/searchKeywords"}}},"type":"appStoreVersionLocalizations"}],"meta":{"paging":{"total":1,"limit":50}}}
