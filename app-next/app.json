{
  "expo": {
    "name": "ExcerLock",
    "slug": "excerlock",
    "owner": "johansardar",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "excerlock",
    "userInterfaceStyle": "light",
    "icon": "./assets/running-lock.png",
    "ios": {
      "bundleIdentifier": "com.johansardar.excerlock",
      "appleTeamId": "AX3C2B78YD",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:excerlock.com"
      ],
      "entitlements": {
        "com.apple.developer.family-controls": true,
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.background-delivery": true,
        "com.apple.security.application-groups": [
          "group.com.johansardar.excerlock"
        ],
        "com.apple.developer.applesignin": [
          "Default"
        ],
        "aps-environment": "development",
        "com.apple.developer.associated-domains": [
          "applinks:excerlock.com"
        ]
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch",
          "processing"
        ],
        "NSUserTrackingUsageDescription": "ExcerLock does not track you across apps or websites. No tracking prompt is shown in v1.",
        "NSLocationAlwaysUsageDescription": "Allow ExcerLock to detect arrivals at saved gyms when you opt into auto-detect.",
        "CFBundleLocalizations": [
          "en"
        ],
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleAlternateIcons": {
          "CFBundlePrimaryIcon": {
            "CFBundleIconFiles": [
              "AppIcon"
            ]
          },
          "AlternateIcon": {
            "CFBundleIconFiles": [
              "AlternateIcon"
            ],
            "UIPrerenderedIcon": false
          }
        }
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "plugins": [
      "./plugins/withScreenTimeExtensionValidation",
      "./plugins/withMainAppEntitlements",
      "./plugins/withPrivacyManifest",
      [
        "@kingstinct/react-native-healthkit",
        {
          "background": false,
          "NSHealthShareUsageDescription": "ExcerLock reads your activity to detect completed fitness conditions on this device.",
          "NSHealthUpdateUsageDescription": false
        }
      ],
      "./plugins/withHealthKitBackgroundBootstrap",
      [
        "react-native-device-activity",
        {
          "appleTeamId": "AX3C2B78YD",
          "appGroup": "group.com.johansardar.excerlock",
          "copyToTargetFolder": false
        }
      ],
      "./modules/excerlock-motion/app.plugin",
      "./modules/excerlock-gait-vision/app.plugin",
      [
        "expo-location",
        {
          "isIosBackgroundLocationEnabled": true,
          "locationWhenInUsePermission": "Allow ExcerLock to check whether you are at a saved gym and keep a Walk Session active.",
          "locationAlwaysAndWhenInUsePermission": "Allow ExcerLock to detect arrivals at saved gyms when you opt into auto-detect."
        }
      ],
      "expo-notifications",
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ExcerLock to use a photo as a condition banner.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "react-native-maps",
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/running-lock.png",
          "imageWidth": 140,
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-font",
      "react-native-adapty",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.4"
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "edge-ix",
          "project": "excerlock-mobile"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9a358379-d939-4c56-bcea-de3ac5699be2"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/9a358379-d939-4c56-bcea-de3ac5699be2",
      "enabled": false
    }
  }
}
