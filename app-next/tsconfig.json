{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@client-services": ["./src/packages/runtime/createClientServices"],
      "@linked-trace": ["./src/packages/trace/LinkedTrace.disabled"],
      "@linked-trace-screen": ["./src/packages/research/LinkedTraceScreen.disabled"],
      "@posthog-runtime": ["./src/packages/telemetry/createPostHogRuntime"],
      "@sentry-binding": ["./src/packages/telemetry/SentryBinding"],
      "@sentry-capture": ["./src/packages/telemetry/SentryCapture"]
    },
    "types": [
      
      "node"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
