{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@client-services": ["./src/runtime/createClientServices"],
      "@linked-trace": ["./src/research/linkedTrace/LinkedTrace.disabled"],
      "@linked-trace-screen": ["./src/research/linkedTrace/LinkedTraceScreen.disabled"],
      "@posthog-runtime": ["./src/runtime/analytics/createPostHogRuntime"],
      "@sentry-binding": ["./src/runtime/observability/SentryBinding"],
      "@sentry-capture": ["./src/runtime/observability/SentryCapture"]
    },
    "types": [
      "jest",
      "node"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
