[Unit]
Description=ExcerLock TestFlight Sandbox API
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=excerlock
Group=excerlock
WorkingDirectory=/opt/excerlock/server
EnvironmentFile=/etc/excerlock/env
ExecStart=/usr/bin/env PORT=3002 SUBSCRIPTION_AUTHORIZATION_STORE_ENVIRONMENT=sandbox DELETION_WORKER_ENABLED=false /usr/bin/node dist/index.js
Restart=always
RestartSec=3
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=full
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
