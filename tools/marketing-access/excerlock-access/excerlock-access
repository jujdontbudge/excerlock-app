#!/bin/bash
set -euo pipefail

API="${EXCERLOCK_ACCESS_API:-https://api.excerlock.com/v1}"
SERVICE="excerlock-access"

usage() {
  cat <<'USAGE'
excerlock-access grant <email> --note "<who and why>" [--until YYYY-MM-DD]
excerlock-access check <email>
excerlock-access revoke <email> --note "<why>"
excerlock-access setup <label>
excerlock-access test

grant   Gives the email free ExcerLock Premium. Re-granting replaces the old grant.
check   Shows whether the email has free Premium and whether they have signed in.
revoke  Ends free Premium for the email (never touches paid subscriptions).
setup   One time, by a human: creates the access token in this Mac's Keychain.
test    Confirms the token works without changing anything.
USAGE
}

fail() { echo "ERROR: $*" >&2; exit 1; }

json() {
  osascript -l JavaScript -e 'function run(a){const o={};for(let i=0;i<a.length;i+=2){if(a[i+1]!=="")o[a[i]]=a[i+1]}return JSON.stringify(o)}' "$@"
}

field() {
  osascript -l JavaScript -e 'function run(a){let v=JSON.parse(a[0]);for(const k of a[1].split("."))v=v==null?v:v[k];return v===null||v===undefined?"":String(v)}' "$1" "$2"
}

until_text() {
  if [[ -n "$1" ]]; then echo "until $1"; else echo "with no end date"; fi
}

token() {
  security find-generic-password -s "$SERVICE" -w 2>/dev/null || fail "No access token on this Mac. A human must run: excerlock-access setup <label>"
}

check_email() {
  local value="$1"
  [[ "$value" =~ ^[^[:space:]@]+@[^[:space:]@]+\.[^[:space:]@]+$ ]] || fail "\"$value\" is not an email address"
  [[ "$value" == "$(printf '%s' "$value" | tr '[:upper:]' '[:lower:]')" ]] || echo "Note: email will be lowercased" >&2
}

call() {
  local method="$1" path="$2" body="${3:-}" response status
  local args=(-sS -X "$method" -H "Authorization: Bearer $(token)" -w $'\n%{http_code}' "$API$path")
  if [[ -n "$body" ]]; then args+=(-H "Content-Type: application/json" --data-binary "$body"); fi
  response="$(curl "${args[@]}")" || fail "Could not reach $API. Check the internet connection."
  status="${response##*$'\n'}"
  BODY="${response%$'\n'*}"
  case "$status" in
    2*) ;;
    401) fail "The access token was rejected. Ask Johan to re-enable it." ;;
    404) fail "The access service is not switched on yet. Ask Johan." ;;
    429) fail "Too many requests. Wait one minute and try again." ;;
    400) fail "Request rejected: $(field "$BODY" error.message 2>/dev/null || echo "$BODY")" ;;
    *) fail "Server error ($status). Nothing was confirmed; run check before retrying." ;;
  esac
}

action="${1:-}"; shift || true
email=""; note=""; until=""
if [[ "$action" =~ ^(grant|check|revoke)$ ]]; then
  email="${1:-}"; [[ -n "$email" && "$email" != --* ]] || fail "Missing email. $(usage)"
  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --note) note="${2:-}"; shift 2 || fail "--note needs text" ;;
      --until) until="${2:-}"; shift 2 || fail "--until needs a date" ;;
      *) fail "Unknown option $1" ;;
    esac
  done
  check_email "$email"
  email="$(printf '%s' "$email" | tr '[:upper:]' '[:lower:]')"
fi

case "$action" in
  grant)
    [[ -n "${note// }" ]] || fail "grant needs --note, for example --note \"UGC @handle, October campaign\""
    if [[ -n "$until" ]]; then
      [[ "$until" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || fail "--until must look like 2026-12-31"
      until="${until}T00:00:00Z"
    fi
    call POST /access/grants "$(json email "$email" note "$note" until "$until")"
    expires="$(field "$BODY" expiresAt)"
    echo "GRANTED: $email has free ExcerLock Premium $(until_text "$expires")."
    echo "Tell them: download ExcerLock from the App Store, tap \"Already have an account? Sign in\", and sign in with exactly $email (email code, Apple or Google)."
    ;;
  check)
    call GET "/access/grants?email=$(osascript -l JavaScript -e 'function run(a){return encodeURIComponent(a[0])}' "$email")"
    if [[ "$(field "$BODY" active)" == "true" ]]; then
      expires="$(field "$BODY" expiresAt)"
      signed="$(field "$BODY" signedIn)"
      echo "ACTIVE: $email has free Premium $(until_text "$expires")."
      if [[ "$signed" == "true" ]]; then echo "They have signed in and received it."; else echo "They have not signed in with this email yet."; fi
    else
      echo "NONE: $email has no active free Premium."
    fi
    ;;
  revoke)
    [[ -n "${note// }" ]] || fail "revoke needs --note, for example --note \"campaign ended\""
    call POST /access/revocations "$(json email "$email" note "$note")"
    if [[ "$(field "$BODY" revoked)" == "0" ]]; then echo "NOTHING TO REVOKE: $email had no active free Premium."; else echo "REVOKED: $email loses free Premium within 24 hours (next app check)."; fi
    ;;
  setup)
    label="${1:-}"
    [[ "$label" =~ ^[a-z0-9-]{1,40}$ ]] || fail "setup needs a lowercase label, for example: excerlock-access setup marketing-air"
    secret="exa_$(openssl rand -hex 32)"
    security add-generic-password -U -s "$SERVICE" -a "$label" -w "$secret"
    hash="$(printf '%s' "$secret" | shasum -a 256 | cut -d' ' -f1)"
    unset secret
    echo "Token saved in this Mac's Keychain. Send Johan this line (it is safe to share, it is not the token):"
    echo
    echo "    $label:$hash"
    ;;
  test)
    call GET "/access/grants?email=token-check%40example.com"
    echo "OK: the access token works."
    ;;
  ""|-h|--help|help) usage ;;
  *) fail "Unknown command \"$action\". $(usage)" ;;
esac
