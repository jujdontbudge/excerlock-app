{
  "name": "excerlock",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "app",
    "server",
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test:unit && npm run test:guardrails",
    "test:unit": "npm run test:packages && npm run test:server && npm run test:app",
    "test:packages": "vitest run --config vitest.packages.config.ts",
    "test:server": "npm run test --workspace server --if-present",
    "test:app": "npm run test --workspace app --if-present",
    "test:guardrails": "vitest run --config guardrails/vitest.config.ts"
  },
  "devDependencies": {
    "vitest": "^4.1.10"
  }
}
