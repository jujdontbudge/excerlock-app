{
  "name": "excerlock",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "server",
    "packages/*",
    "app-next",
    "tools/excer"
  ],
  "scripts": {
    "postinstall": "patch-package --patch-dir app-next/patches",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15",
    "@esbuild-kit/core-utils": {
      "esbuild": ">=0.25.4"
    },
    "decode-uri-component": "0.5.0",
    "jayson": "^5.0.0",
    "uuid@<11.1.1": "^11.1.1",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  },
  "dependencies": {
    "@sentry/core": "10.37.0"
  }
}
