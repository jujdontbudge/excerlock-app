{
  "name": "excerlock",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "app",
    "server",
    "packages/*",
    "guardrails",
    "app-next"
  ],
  "scripts": {
    "postinstall": "patch-package --patch-dir app/patches",
    "test": "npm run typecheck && npm run test:unit && npm run test:guardrails",
    "test:unit": "npm run test:app-next && npm run test:packages && npm run test:server && npm run test:app && npm run test:e2e-contract",
    "test:app-next": "npm run test --workspace app-next",
    "test:packages": "vitest run --config vitest.packages.config.ts",
    "test:server": "npm run test --workspace server --if-present",
    "test:app": "npm run test --workspace app --if-present",
    "test:guardrails": "npm run prebuild:guardrails --workspace app && vitest run --config guardrails/vitest.config.ts",
    "test:release-guardrails": "vitest run --config guardrails/vitest.config.ts guardrails/release",
    "typecheck": "npm run typecheck --workspaces",
    "test:e2e-contract": "node --test e2e/tests/*.test.mjs"
  },
  "devDependencies": {
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "@react-native/jest-preset": "0.86.3"
  }
}
