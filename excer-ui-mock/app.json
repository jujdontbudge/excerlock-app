{
  "expo": {
    "name": "ExcerLock UI Mock",
    "slug": "excer-ui-mock",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "excerlockmock",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.johansardar.excerlock.uimock"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3445E6",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.johansardar.excerlock.uimock"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3445E6",
          "image": "./assets/splash-logo.png",
          "imageWidth": 132
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
